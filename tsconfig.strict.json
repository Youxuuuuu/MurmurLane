{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "strict": true,
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/content-sync/**/*.ts",
    "src/content-sync/**/*.tsx",
    "src/workspaces/**/*.ts",
    "src/workspaces/**/*.tsx"
  ]
}
